# Elasticsearch endpoint (Elastic Cloud console > deployment > Elasticsearch endpoint)
ELASTIC_URL=https://my-deployment.es.us-east-1.aws.elastic.cloud:443
# Kibana endpoint (Agent Builder and the MCP server live here)
KIBANA_URL=https://my-deployment.kb.us-east-1.aws.elastic.cloud:443
# Admin/setup key: creates indices, loads data, registers Agent Builder tools
ELASTIC_ADMIN_API_KEY=
# Optional: a user login, only needed by 03_create_api_key.py (API keys cannot mint privileged keys)
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
# Read-only key from 03_create_api_key.py: used by 05_verify_mcp.py and by AgentCore Gateway
ELASTIC_API_KEY=
# OAuth public client for the Elastic MCP server (optional; alternative to ELASTIC_API_KEY)
ELASTIC_MCP_OAUTH_CLIENT_ID=
