# Copy to .env and fill in. Do not leave angle-bracket placeholders: scripts load this file with `source`.

# Elastic Cloud Serverless (Observability)
KIBANA_URL=https://my-project-a1b2c3.kb.us-west-2.aws.elastic.cloud
ES_URL=https://my-project-a1b2c3.es.us-west-2.aws.elastic.cloud
MCP_URL=https://my-project-a1b2c3.kb.us-west-2.aws.elastic.cloud/api/agent_builder/mcp
# Setup scripts only; never given to AWS DevOps Agent
ELASTIC_ADMIN_API_KEY=
# Read-only key for AWS DevOps Agent (elastic-config/security/mcp-readonly-api-key.json)
ELASTIC_MCP_API_KEY=

# AWS DevOps Agent
AWS_REGION=ap-southeast-2
# Named profile for the workshop account. Delete this line to use your default credentials.
AWS_PROFILE=workshop
# Filled in after the Agent Space and webhook are created
AGENT_SPACE_ID=
DEVOPS_AGENT_WEBHOOK_URL=
DEVOPS_AGENT_WEBHOOK_TOKEN=

# Elastic Cloud Managed OTLP Endpoint and ingest key
OTLP_ENDPOINT=https://my-project-a1b2c3.ingest.us-west-2.aws.elastic.cloud
OTLP_API_KEY=

# Fixed stack names, so re-runs update the same stacks instead of creating new ones
STACK_NAME=elastic-devops-agent-space
MCP_STACK_NAME=elastic-devops-agent-mcp-stack
